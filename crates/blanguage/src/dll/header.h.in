
/* 0=CPU, 1=GPU. Return 0 on success, -1 on error (UTF-8).
   Handle calls/destroy: serial, on its creating thread.
   Data pointers: count valid records, writable ranges must not overlap.
   run is synchronous, including GPU upload, completion and output download.
   error may be NULL only when capacity=0. destroy accepts NULL. */
typedef struct @PREFIX@_handle @PREFIX@_handle;
#ifdef __cplusplus
extern "C" {
#endif
__declspec(dllimport) int32_t @PREFIX@_create(uint32_t backend, @PREFIX@_handle **out, char *error, size_t capacity);
__declspec(dllimport) int32_t @PREFIX@_run(@PREFIX@_handle *handle@COMMA@@C_PARAMS@, char *error, size_t capacity);
__declspec(dllimport) void @PREFIX@_destroy(@PREFIX@_handle *handle);
#ifdef __cplusplus
}
#include <stdexcept>
namespace blink_@PREFIX@ {
enum class Backend : uint32_t { Cpu=0, Gpu=1 };
class Program {
    @PREFIX@_handle *handle_ = nullptr;
public:
