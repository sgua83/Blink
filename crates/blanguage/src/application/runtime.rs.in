use std::ffi::c_void;
#[repr(C)]
pub struct ModuleImage {
    pub data: *const u8,
    pub bytes: usize,
}
#[repr(C)]
pub struct UniformValue { pub kind: u32, pub bits: u32 }
static IMAGE: &[u8] = &@IMAGE@;
#[unsafe(no_mangle)]
pub extern "C" fn @PREFIX@_resources() -> ModuleImage {
    ModuleImage { data: IMAGE.as_ptr(), bytes: IMAGE.len() }
}
