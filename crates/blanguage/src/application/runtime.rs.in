#![allow(unused_imports)]
use blanguage::{TemplateProgram, ast::{Access, Target, ExternalName}, ir::*, native::{NativeCode, NativeIntrinsic, NativeSymbol, Relocation, RangeResult, ContinuationCode, SortCode as NativeSortCode, StageCode as NativeStageCode, ProgramImage as NativeProgramImage}, spirv::{ShaderCode, StageCode as ShaderStageCode, ProgramImage as ShaderProgramImage}};
use blcompute::application::{Frame, ProgramImage,ModuleResources};
use blcompute::Value;
use std::collections::BTreeSet;
fn fail(error:Box<dyn std::error::Error+Send+Sync>)->!{eprintln!("{error}");std::process::exit(1)}
unsafe fn finish<T>(frame:*mut Frame,result:blcompute::Result<T>)->T{
    match result{Ok(value)=>value,Err(error)=>{drop(unsafe{Box::from_raw(frame)});fail(error)}}
}
unsafe extern "C"{static @PREFIX@_type_base:u32;static @PREFIX@_program_base:u32;}
#[unsafe(no_mangle)]
pub extern "C" fn @PREFIX@_resources()->*mut ModuleResources{
    Box::into_raw(Box::new(ModuleResources{types:@TYPES@,programs:@IMAGES@}))
}
